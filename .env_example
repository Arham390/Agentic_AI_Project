GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# -------------------------
# PHASE 2 PIPELINE CONTROLS
# -------------------------
# Keep this 0 until external commands below are configured.
# Set to 1 to fail-fast on any fallback or missing production backend.
PHASE2_STRICT_PRODUCTION=1

# Debug visual placeholders (legacy circle/mouth overlays).
# 0 = disabled (recommended), 1 = enabled for troubleshooting only.
PHASE2_DEBUG_PLACEHOLDERS=0

# Burn title bars into frames.
# 0 = off for final renders, 1 = on for debug previews.
PHASE2_BURN_OVERLAYS=0

# Scene-level regeneration attempts for quality-gated stages.
PHASE2_SCENE_RETRIES=2

# Face swap (OpenCV identity paste). Set to 0 to use generated frames as-is (often looks better).
PHASE2_FACE_SWAP_ENABLED=1

# 4-8 storyboard keyframes per scene.
PHASE2_STORYBOARD_KEYFRAMES=4
# Minimum successful keyframes required from local-sd/comfyui per scene in strict mode.
PHASE2_MIN_KEYFRAMES=3

# -------------------------
# IMAGE BACKEND (pick one)
# -------------------------
# Option A: Local SD (enabled by default here)
USE_LOCAL_SD=1
SD_LOCAL_MODEL=stabilityai/sd-turbo
SD_LOCAL_DEVICE=cpu
SD_LOCAL_WIDTH=768
SD_LOCAL_HEIGHT=432
SD_LOCAL_STEPS=6
SD_LOCAL_CFG=0.0
SD_LOCAL_NEGATIVE=blurry, low quality, watermark, text, logo, deformed face
# Optional for gated HF models:
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Option B: ComfyUI (leave commented unless using ComfyUI)
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=your-model.safetensors
# COMFYUI_WIDTH=768
# COMFYUI_HEIGHT=432
# COMFYUI_STEPS=28
# COMFYUI_CFG=7
# COMFYUI_NEGATIVE=blurry, low quality, watermark, text, logo
# COMFYUI_TIMEOUT_SEC=300

# -------------------------
# EXTERNAL VIDEO BACKENDS
# -------------------------
# Motion synthesis command (AnimateDiff / SVD / ZeroScope wrapper script)
# Available placeholders: {scene_id} {keyframe_dir} {output_dir} {fps}
MOTION_SYNTH_CMD='"C:\Users\msbm2\Downloads\Agentic AI\A3\.venv\Scripts\python.exe" "C:\Users\msbm2\Downloads\Agentic AI\A3\tools\cmd_wrappers\motion_synth.py" --scene {scene_id} --keyframes "{keyframe_dir}" --output "{output_dir}" --fps {fps}'
MOTION_SYNTH_TIMEOUT_SEC=600

# Frame interpolation command (set one)
# Available placeholders: {scene_id} {input_dir} {output_dir}
RIFE_INTERP_CMD='"C:\Users\msbm2\Downloads\Agentic AI\A3\.venv\Scripts\python.exe" "C:\Users\msbm2\Downloads\Agentic AI\A3\tools\cmd_wrappers\interpolate_frames.py" --scene {scene_id} --input "{input_dir}" --output "{output_dir}" --factor 2'
# FILM_INTERP_CMD=
INTERP_TIMEOUT_SEC=600

# Lip-sync command (set one)
# Available placeholders: {scene_id} {audio} {frames_dir} {output} {fps}
WAV2LIP_INFER_CMD='"C:\Users\msbm2\Downloads\Agentic AI\A3\.venv\Scripts\python.exe" "C:\Users\msbm2\Downloads\Agentic AI\A3\tools\cmd_wrappers\lipsync_mux.py" --scene {scene_id} --audio "{audio}" --frames "{frames_dir}" --output "{output}" --fps {fps}'
# SADTALKER_INFER_CMD=
LIPSYNC_TIMEOUT_SEC=1200